# ============================================
# مفتاح الذكاء الاصطناعي — Groq (مجاني)
# ============================================
# 1) سجّل في: https://console.groq.com/keys
# 2) أنشئ مفتاحاً (يبدأ بـ gsk_) وألصقه بعد علامة =
# 3) احفظ الملف ثم شغّل run_project.bat
#
# لا تشارك هذا الملف مع أحد — يحوي مفتاحك السري.

GROQ_API_KEY=

# (اختياري) تغيير النموذج — الافتراضي llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.1-8b-instant

